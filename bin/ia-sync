#!/usr/bin/env python3
"""ia-sync: mantém ~/.ia como fonte única de skills, agentes, instruções, MCPs e
configs de IA, e liga (symlink) / gera os arquivos que cada ferramenta espera.

Uso:
  ia-sync            importa o que estiver solto nas ferramentas e sincroniza tudo
  ia-sync --dry-run  só mostra o que faria
  ia-sync --quiet    só imprime avisos/erros
  ia-sync status     mostra o estado de cada ferramenta
"""
import argparse, filecmp, hashlib, json, os, re, shutil, subprocess, sys, tarfile, time, tomllib
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("ia-sync precisa do PyYAML: sudo apt install python3-yaml  (ou pip install pyyaml)")

HOME = Path.home()
MARKER = ".ia-sync-home"  # marca a pasta escolhida na instalação


def find_ia():
    """Pasta das configs: $IA_HOME > pasta onde o script está instalado (<pasta>/bin/ia-sync) > ~/.ia."""
    if os.environ.get("IA_HOME"):
        return Path(os.environ["IA_HOME"]).expanduser().resolve()
    here = Path(__file__).resolve().parent.parent
    if (here / MARKER).exists():
        return here
    return HOME / ".ia"


IA = find_ia()
SHOW = f"~/{IA.relative_to(HOME)}" if IA.is_relative_to(HOME) else str(IA)  # pra mensagens
TS = time.strftime("%Y%m%d-%H%M%S")
STATE_FILE = IA / ".state.json"
SECRETS = IA / "secrets.env"
MCP_FILE = IA / "mcp" / "servers.json"
AGENTS_MD = IA / "AGENTS.md"
IGNORED_SKILL_DIRS = {"synced", ".system"}  # gerenciadas pelo próprio fornecedor

DRY = QUIET = False
changes, warnings = [], []


def info(msg):
    changes.append(msg)
    if not QUIET:
        print("  " + msg)


def warn(msg):
    warnings.append(msg)
    print("  ⚠ " + msg, file=sys.stderr)


# ---------------------------------------------------------------- ferramentas
def tools():
    """Ferramentas instaladas no WSL (só entram se o diretório home existir)."""
    t = []
    c = HOME / ".claude"
    if c.is_dir():
        t.append(dict(id="claude", home=c, skills=c / "skills", agents=c / "agents", agents_fmt="claude",
                      instructions=c / "CLAUDE.md", mcp="claude-cli",
                      settings=[("settings/claude/settings.json", c / "settings.json")]))
    x = HOME / ".codex"
    if x.is_dir():
        t.append(dict(id="codex", home=x, skills=x / "skills", agents=x / "agents", agents_fmt="codex",
                      instructions=x / "AGENTS.md", mcp="codex-toml",
                      settings=[("settings/codex/config.toml", x / "config.toml")]))
    p = HOME / ".copilot"
    if p.is_dir():
        t.append(dict(id="copilot", home=p, skills=p / "skills", agents=p / "agents", agents_fmt="copilot",
                      instructions=p / "copilot-instructions.md", mcp="copilot-json", mcp_file=p / "mcp-config.json",
                      settings=[("settings/copilot/config.json", p / "config.json")]))
    k = Path(os.environ.get("KIRO_HOME") or HOME / ".kiro")
    if k.is_dir():
        ide = HOME / ".config" / "Kiro" / "User"  # Kiro IDE (servidor no WSL)
        t.append(dict(id="kiro", home=k, skills=k / "skills", agents=k / "agents", agents_fmt="kiro",
                      instructions=k / "steering" / "AGENTS.md", mcp="kiro-json", mcp_file=k / "settings" / "mcp.json",
                      steering=k / "steering",
                      settings=[("settings/kiro/cli.json", k / "settings" / "cli.json"),
                                ("settings/kiro/permissions.yaml", k / "settings" / "permissions.yaml"),
                                ("settings/kiro/sandbox.json", k / "settings" / "sandbox.json"),
                                ("settings/kiro/hooks", k / "hooks"),
                                ("settings/kiro/workflows", k / "workflows"),
                                ("settings/kiro/powers", k / "powers"),
                                ("settings/kiro/ide/settings.json", ide / "settings.json"),
                                ("settings/kiro/ide/keybindings.json", ide / "keybindings.json")]))
    g = HOME / ".gemini"
    if g.is_dir():
        # o settings.json do Gemini guarda config e MCPs juntos: o arquivo vira link e o ia-sync
        # só reescreve a chave "mcpServers" dentro dele.
        t.append(dict(id="gemini", home=g, skills=g / "skills", agents=None, agents_fmt=None,
                      instructions=g / "GEMINI.md", mcp="gemini-json", mcp_file=g / "settings.json",
                      settings=[("settings/gemini/settings.json", g / "settings.json")]))
    return t


def rel_home(p):
    p = Path(p)
    try:
        return str(p.relative_to(HOME))
    except ValueError:  # ex.: KIRO_HOME fora da home
        return str(p).lstrip("/")


def real_path(t, p):
    """Se p é um config ligado ao ~/.ia (ou que vai ser), devolve o arquivo canônico."""
    for rel, target in t.get("settings", []):
        if Path(p) == target and ((IA / rel).exists() or not target.exists()):
            return IA / rel
    return Path(p)


# ---------------------------------------------------------------- utilidades
def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {"generated": {}, "mcp": {}}


def save_state(s):
    if not DRY:
        STATE_FILE.write_text(json.dumps(s, indent=2, sort_keys=True) + "\n")


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def same(a, b):
    a, b = Path(a), Path(b)
    if a.is_file() and b.is_file():
        return filecmp.cmp(a, b, shallow=False)
    if a.is_dir() and b.is_dir():
        d = filecmp.dircmp(a, b)
        if d.left_only or d.right_only or d.funny_files:
            return False
        _, diff, err = filecmp.cmpfiles(a, b, d.common_files, shallow=False)  # dircmp sozinho compara só tamanho/data
        if diff or err:
            return False
        return all(same(a / s, b / s) for s in d.common_dirs)
    return False


def same_normalized(a, b):
    """Igual depois de padronizar (ex.: mesma skill no Claude e no Codex, cada uma com seu caminho)."""
    a, b = Path(a), Path(b)
    fa = {f.relative_to(a) for f in a.rglob("*") if f.is_file()} if a.is_dir() else {Path(".")}
    fb = {f.relative_to(b) for f in b.rglob("*") if f.is_file()} if b.is_dir() else {Path(".")}
    if fa != fb:
        return False
    for r in fa:
        x, y = (a / r, b / r) if a.is_dir() else (a, b)
        try:
            tx, ty = fix_paths(x.read_text()), fix_paths(y.read_text())
        except (UnicodeDecodeError, OSError):
            if not filecmp.cmp(x, y, shallow=False):
                return False
            continue
        if x.name == "SKILL.md":
            tx, ty = fix_skill_front(tx, a.name)[0], fix_skill_front(ty, a.name)[0]
        if tx != ty:
            return False
    return True


def backup(path, label):
    dest = IA / "_backup" / TS / label
    info(f"backup {path} -> {dest}")
    if DRY:
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(dest))


def points_into_ia(p):
    p = Path(p)
    if not p.is_symlink():
        return False
    target = Path(os.path.normpath(p.parent / os.readlink(p)))
    return str(target).startswith(str(IA) + os.sep)


def symlink(src, dst):
    """dst -> src. Retorna True se mudou algo."""
    src, dst = Path(src), Path(dst)
    if dst.is_symlink() and Path(os.readlink(dst)) == src:
        return False
    if dst.exists() or dst.is_symlink():
        if dst.is_symlink():
            if not DRY:
                dst.unlink()
        else:
            backup(dst, f"replaced/{rel_home(dst)}")
    info(f"link {dst} -> {src}")
    if not DRY:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(src)
    return True


def write_generated(path, content, state):
    """Escreve arquivo gerado; se alguém editou o gerado direto, faz backup antes."""
    path = Path(path)
    key = str(path)
    if path.is_symlink():
        if not DRY:
            path.unlink()
    elif path.exists():
        cur = path.read_text()
        if cur == content:
            state["generated"][key] = hashlib.sha256(content.encode()).hexdigest()
            return
        if state["generated"].get(key) != sha(path):
            warn(f"{path} foi editado fora do {SHOW}; backup feito antes de sobrescrever")
            backup(path, f"edited/{rel_home(path)}")
    info(f"gerado {path}")
    if not DRY:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
    state["generated"][key] = hashlib.sha256(content.encode()).hexdigest()


FRONT_RE = re.compile(r"^---\n(.*?)\n---\n?(.*)$", re.S)


def parse_front(text):
    m = FRONT_RE.match(text)
    if not m:
        return {}, text
    try:
        meta = yaml.safe_load(m.group(1)) or {}
    except Exception as e:
        raise ValueError(f"frontmatter YAML inválido: {e}")
    if not isinstance(meta, dict):
        raise ValueError("frontmatter YAML inválido: não é um mapa chave: valor")
    return meta, m.group(2)


def dump_front(meta, body):
    """Frontmatter no padrão: name/description (e argument-hint) sempre entre aspas duplas."""
    lines = []
    for k in ("name", "description", "argument-hint"):
        if meta.get(k) is not None:
            lines.append(f"{k}: {json.dumps(str(meta[k]), ensure_ascii=False)}")
    rest = {k: v for k, v in meta.items() if k not in ("name", "description", "argument-hint")}
    if rest:
        lines.append(yaml.safe_dump(rest, allow_unicode=True, sort_keys=False, width=10000).rstrip())
    return "---\n" + "\n".join(lines) + "\n---\n" + ("\n" if not body.startswith("\n") else "") + body.lstrip("\n").rstrip() + "\n"


# caminhos de script que apontam pra skill dentro de uma ferramenta -> ~/.ia/skills/
_HOME_RE = "|".join(re.escape(h) for h in ("~", "$HOME", "${HOME}", str(HOME)))
TOOL_IDS = ("claude", "codex", "copilot", "kiro", "gemini")
TOOL_SKILL_RE = re.compile(rf"({_HOME_RE})/\.(?:claude|codex|copilot|kiro|gemini)/skills/(?!synced/)(?=[A-Za-z0-9_-]+/)")


def fix_paths(text):
    try:  # dentro da home: mantém o estilo (~/..., $HOME/...)
        rel = (IA / "skills").relative_to(HOME)
        return TOOL_SKILL_RE.sub(lambda m: f"{m.group(1)}/{rel}/", text)
    except ValueError:
        return TOOL_SKILL_RE.sub(str(IA / "skills") + "/", text)


def fix_skill_front(text, folder):
    """Conserta o frontmatter da skill. Devolve (texto_novo, avisos)."""
    notes = []
    m = FRONT_RE.match(text)
    raw, body = (m.group(1), m.group(2)) if m else ("", text)
    try:
        meta = yaml.safe_load(raw) or {}
        if not isinstance(meta, dict):
            raise ValueError
        quoted = all(re.search(rf'^{k}:\s*"', raw, re.M) for k in ("description", "argument-hint")
                     if re.search(rf"^{k}:\s*\S", raw, re.M))
        if m and quoted and meta.get("name") == folder and meta.get("description"):
            return text, []  # já está no padrão: não reescreve (mantém comentários/formatação)
    except Exception:
        # YAML inválido quase sempre é valor com ": " sem aspas: põe aspas linha a linha
        out = []
        for line in raw.split("\n"):
            mm = re.match(r"^([A-Za-z0-9_-]+):[ \t]+(.+?)\s*$", line)
            if mm and mm.group(2)[0] not in "\"'|>[{&*!":
                line = f"{mm.group(1)}: {json.dumps(mm.group(2), ensure_ascii=False)}"
            out.append(line)
        try:
            meta = yaml.safe_load("\n".join(out)) or {}
            if not isinstance(meta, dict):
                raise ValueError
        except Exception:
            return text, ["frontmatter YAML inválido e não consegui consertar sozinho; corrija à mão"]
    if meta.get("name") != folder:
        meta["name"] = folder
    if not meta.get("description"):
        first = next((l.strip(" #*_>-") for l in body.splitlines() if l.strip() and not l.lstrip().startswith(("#", "```"))), "")
        meta["description"] = first[:250] or folder
        notes.append("não tinha 'description'; gerei uma a partir do texto, revise")
    meta = {"name": meta.pop("name"), "description": meta.pop("description"), **meta}
    return dump_front(meta, body), notes


def load_secrets():
    env = {}
    if SECRETS.exists():
        for line in SECRETS.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                env[k.strip()] = v
    return env


def add_secret(name, value, secrets):
    secrets[name] = value
    if DRY:
        return
    lines = SECRETS.read_text().splitlines() if SECRETS.exists() else ["# segredos usados em mcp/servers.json como ${NOME}. NÃO versionar."]
    lines = [l for l in lines if not l.startswith(name + "=")]
    lines.append(f"{name}={json.dumps(value)}")
    SECRETS.write_text("\n".join(lines) + "\n")
    SECRETS.chmod(0o600)


def expand(obj, secrets):
    if isinstance(obj, str):
        def rep(m):
            k = m.group(1)
            if k in secrets:
                return secrets[k]
            if k in os.environ:
                return os.environ[k]
            warn(f"variável ${{{k}}} não definida em secrets.env")
            return m.group(0)
        return re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", rep, obj)
    if isinstance(obj, list):
        return [expand(v, secrets) for v in obj]
    if isinstance(obj, dict):
        return {k: expand(v, secrets) for k, v in obj.items()}
    return obj


# ---------------------------------------------------------------- importação
def adopt_entry(src, dest, label):
    """Move src para dest no ~/.ia. Se já existir igual, descarta; se diferente, vai pra _conflicts."""
    src, dest = Path(src), Path(dest)
    if not dest.exists():
        info(f"importado {src} -> {dest}")
        if not DRY:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(src), str(dest))
    elif same(src, dest) or same_normalized(src, dest):
        info(f"{src} já existe igual em {dest}; removendo duplicata")
        if not DRY:
            shutil.rmtree(src) if src.is_dir() else src.unlink()
    else:
        c = IA / "_conflicts" / label / f"{src.name}-{TS}"
        warn(f"{src} diverge de {dest}; movido para {c} (mescle à mão e apague)")
        if not DRY:
            c.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(src), str(c))


def import_skills(t):
    d = t["skills"]
    if not d or not d.is_dir() or d.is_symlink():
        return
    for e in sorted(d.iterdir()):
        if e.name in IGNORED_SKILL_DIRS or e.name.startswith(".") or e.is_symlink() or not e.is_dir():
            continue
        if not (e / "SKILL.md").exists():
            continue
        adopt_entry(e, IA / "skills" / e.name, f"skills/{t['id']}")


def import_agents(t):
    d = t.get("agents")
    if not d or not d.is_dir() or d.is_symlink():
        return
    state = load_state()
    fmt = t["agents_fmt"]
    prompt_files = kiro_prompt_files(d) if fmt == "kiro" else set()
    for e in sorted(d.iterdir()):
        if e.is_symlink() or str(e) in state["generated"] or not e.is_file() or e in prompt_files:
            continue
        if fmt == "claude" and e.suffix == ".md":
            adopt_entry(e, IA / "agents" / e.name, f"agents/{t['id']}")
            continue
        try:
            conv = agent_from_tool(fmt, e)
        except Exception as ex:
            warn(f"não consegui converter o agente {e}: {ex}")
            continue
        if conv:
            stem, text = conv
            pf = kiro_prompt_file(e) if e.suffix == ".json" else None
            adopt_converted(e, IA / "agents" / f"{stem}.md", text, f"agents/{t['id']}")
            if pf:  # o prompt já foi copiado pra dentro do agente
                if pf.parent == d.resolve() and pf.exists():
                    backup(pf, f"imported/{rel_home(pf)}")


def kiro_prompt_file(f):
    try:
        pr = str(json.loads(f.read_text()).get("prompt") or "") if f.exists() else ""
    except Exception:
        return None
    if not pr.startswith("file://"):
        return None
    pf = Path(os.path.expanduser(pr[7:]))
    return (pf if pf.is_absolute() else f.parent / pf).resolve()


def kiro_prompt_files(d):
    return {p for p in (kiro_prompt_file(f) for f in d.glob("*.json")) if p}


AGENT_CORE = ("name", "description")


def agent_from_tool(fmt, f):
    """Converte agente no formato da ferramenta pro canônico (.md do Claude).
    Campos que só aquela ferramenta entende ficam guardados em `<ferramenta>:` no frontmatter
    e voltam quando o arquivo dela é gerado de novo."""
    if fmt == "copilot" and f.name.endswith(".agent.md"):
        meta, body = parse_front(f.read_text())
        stem = f.name[: -len(".agent.md")]
    elif fmt == "codex" and f.suffix == ".toml":
        meta = tomllib.loads(f.read_text())
        body = str(meta.pop("developer_instructions", ""))
        stem = f.stem
    elif fmt == "kiro" and f.suffix == ".md":  # agente Markdown do Kiro V3: frontmatter = config, corpo = prompt
        meta, body = parse_front(f.read_text())
        stem = f.stem
    elif fmt == "kiro" and f.suffix == ".json":
        meta = json.loads(f.read_text())
        body = str(meta.pop("prompt", "") or "")
        if body.startswith("file://"):
            pf = Path(os.path.expanduser(body[7:]))
            pf = pf if pf.is_absolute() else f.parent / pf
            body = pf.read_text() if pf.is_file() else body
        stem = f.stem
    else:
        return None
    canon = {"name": meta.get("name") or stem, "description": meta.get("description") or ""}
    extra = {k: v for k, v in meta.items() if k not in AGENT_CORE}
    if extra:
        canon[fmt] = extra
    return stem, dump_front(canon, fix_paths(body.strip()))


def adopt_converted(src, dest, text, label):
    if dest.exists():
        try:
            dm, db = parse_front(dest.read_text())
            nm, nb = parse_front(text)
        except ValueError:
            dm = None
        if dm is not None and db.strip() == nb.strip() and str(dm.get("description", "")) == str(nm.get("description", "")):
            tool = label.split("/")[-1]
            if nm.get(tool) and dm.get(tool) != nm.get(tool):  # guarda os campos extras dessa ferramenta
                dm[tool] = nm[tool]
                if not DRY:
                    dest.write_text(dump_front(dm, db))
            info(f"{src} já existe em {dest}; removendo duplicata")
            backup(src, f"imported/{rel_home(src)}")
            return
        c = IA / "_conflicts" / label / f"{dest.name}-{TS}"
        warn(f"{src} diverge de {dest}; versão convertida em {c} (mescle à mão e apague)")
        if not DRY:
            c.parent.mkdir(parents=True, exist_ok=True)
            c.write_text(text)
        backup(src, f"imported/{rel_home(src)}")
        return
    info(f"importado {src} -> {dest} (convertido)")
    if not DRY:
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text)
    backup(src, f"imported/{rel_home(src)}")


def import_instructions(t):
    f = t.get("instructions")
    if not f or f.is_symlink() or not f.exists():
        return
    body = f.read_text().strip()
    cur = AGENTS_MD.read_text() if AGENTS_MD.exists() else ""
    if body and body not in cur:
        info(f"instruções de {f} anexadas em {AGENTS_MD}")
        if not DRY:
            AGENTS_MD.write_text(cur.rstrip() + f"\n\n<!-- importado de {f} em {TS} -->\n{body}\n")
    backup(f, f"instructions/{t['id']}/{f.name}")


def import_steering(t):
    """Steering global do Kiro. Os que valem sempre (sem frontmatter ou inclusion: always) são instrução
    global -> entram no AGENTS.md (todas as IAs). Os condicionais (fileMatch/manual/auto) só o Kiro
    entende -> vão pra ~/.ia/settings/kiro/steering e cada um vira link."""
    d = t.get("steering")
    if not d or not d.is_dir():
        return
    keep = IA / "settings" / "kiro" / "steering"
    for f in sorted(d.glob("*.md")):
        if f.is_symlink() or f == t.get("instructions"):
            continue
        try:
            meta, body = parse_front(f.read_text())
        except ValueError:
            meta, body = {"inclusion": "?"}, f.read_text()
        if str(meta.get("inclusion", "always")) == "always":
            cur = AGENTS_MD.read_text() if AGENTS_MD.exists() else ""
            if body.strip() and body.strip() not in cur:
                info(f"steering {f} (sempre ativo) anexado em {AGENTS_MD}")
                if not DRY:
                    AGENTS_MD.write_text(cur.rstrip() + f"\n\n<!-- importado de {f} em {TS} -->\n{body.strip()}\n")
            backup(f, f"instructions/kiro/steering/{f.name}")
        else:
            adopt_entry(f, keep / f.name, "settings/kiro/steering")


def sync_steering(t):
    d, keep = t.get("steering"), IA / "settings" / "kiro" / "steering"
    if not d or not keep.is_dir():
        return
    want = {f.name for f in keep.glob("*.md")}
    for n in sorted(want):
        symlink(keep / n, d / n)
    for e in d.iterdir() if d.is_dir() else []:
        if e.name not in want and e != t.get("instructions") and points_into_ia(e) and str(Path(os.readlink(e))).startswith(str(keep)):
            info(f"removido link órfão {e}")
            if not DRY:
                e.unlink()


def import_settings(t):
    for rel, target in t["settings"]:
        canon = IA / rel
        if target.is_symlink() or not target.exists():
            continue
        if target.is_dir():  # pasta (hooks, workflows, powers...): junta item a item
            if not canon.exists():
                info(f"config {target} -> {canon}")
                if not DRY:
                    canon.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(target), str(canon))
                continue
            for e in sorted(target.iterdir()):
                adopt_entry(e, canon / e.name, f"settings/{rel}")
            if not DRY and not any(target.iterdir()):
                target.rmdir()
            continue
        # arquivo real no lugar do link: ou é a 1ª vez, ou a ferramenta recriou o arquivo (escrita atômica).
        # Em ambos os casos a versão da ferramenta é a mais recente.
        if canon.exists() and not same(canon, target):
            backup(canon, f"settings/{rel}")
        info(f"config {target} -> {canon}")
        if not DRY:
            canon.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(target), str(canon))


def to_canon_server(name, srv, secrets, src=""):
    """Normaliza p/ formato Claude e tira segredos literais para secrets.env."""
    out = {}
    url = srv.get("url") or srv.get("httpUrl")
    if url:
        sse = srv.get("type") == "sse" or (src == "gemini" and not srv.get("httpUrl"))  # no Gemini, "url" = SSE
        out["type"] = "sse" if sse else "http"
        out["url"] = url
        headers = dict(srv.get("headers") or srv.get("http_headers") or {})
        if srv.get("bearer_token_env_var"):
            headers["Authorization"] = "Bearer ${" + srv["bearer_token_env_var"] + "}"
        if headers:
            out["headers"] = headers
    else:
        out["type"] = "stdio"
        out["command"] = srv.get("command")
        if srv.get("args"):
            out["args"] = list(srv["args"])
        if srv.get("env"):
            out["env"] = dict(srv["env"])
    known = {"type", "url", "httpUrl", "headers", "http_headers", "bearer_token_env_var", "command", "args", "env"}
    extra = {k: v for k, v in srv.items() if k not in known and not (src == "copilot" and k == "tools" and v == ["*"])}
    if extra and src in TOOL_IDS:
        out[src] = extra
    for field in ("headers", "env"):
        for k, v in list(out.get(field, {}).items()):
            if isinstance(v, str) and v and "${" not in v:
                var = re.sub(r"[^A-Z0-9]+", "_", f"MCP_{name}_{k}".upper()).strip("_")
                add_secret(var, v, secrets)
                out[field][k] = "${" + var + "}"
    return out


def import_mcp(tl):
    canon = json.loads(MCP_FILE.read_text()) if MCP_FILE.exists() else {"mcpServers": {}}
    servers = canon.setdefault("mcpServers", {})
    secrets = load_secrets()
    found = {}
    cj = HOME / ".claude.json"
    if cj.exists() and any(t["id"] == "claude" for t in tl):
        found.update({n: ("claude", s) for n, s in json.loads(cj.read_text()).get("mcpServers", {}).items()})
    cfg = IA / "settings/codex/config.toml"
    if not cfg.exists():
        cfg = HOME / ".codex/config.toml"
    if cfg.exists():
        try:
            for n, s in tomllib.loads(cfg.read_text()).get("mcp_servers", {}).items():
                found.setdefault(n, ("codex", s))
        except Exception as e:
            warn(f"não consegui ler {cfg}: {e}")
    for t in tl:
        mf = t.get("mcp_file") and real_path(t, t["mcp_file"])
        if mf and mf.exists():
            try:
                for n, s in json.loads(mf.read_text()).get("mcpServers", {}).items():
                    found.setdefault(n, (t["id"], s))
            except Exception as e:
                warn(f"não consegui ler {mf}: {e}")
    managed = set(load_state().get("mcp", {}).get("managed", []))
    for n, (src, s) in found.items():
        if n in servers or n in managed:
            continue
        info(f"MCP '{n}' importado de {src}")
        servers[n] = to_canon_server(n, s, secrets, src)
    if not DRY:
        MCP_FILE.parent.mkdir(parents=True, exist_ok=True)
        MCP_FILE.write_text(json.dumps(canon, indent=2, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- sincronização
def text_files(root):
    for f in sorted(Path(root).rglob("*")):
        if f.is_file() and not f.is_symlink() and f.stat().st_size < 1_000_000:
            try:
                yield f, f.read_text()
            except (UnicodeDecodeError, OSError):
                continue


def normalize():
    """Deixa skills e agentes no padrão: frontmatter válido e com aspas, name = pasta,
    e scripts chamados por ~/.ia/skills/... em vez de ~/.claude/skills/... etc."""
    for d in sorted((IA / "skills").iterdir()):
        f = d / "SKILL.md"
        if not d.is_dir() or not f.exists():
            continue
        for g, text in text_files(d):
            new = fix_paths(text)
            notes = []
            if g == f:
                new, notes = fix_skill_front(new, d.name)
            for n in notes:
                warn(f"{f}: {n}")
            if new != text:
                info(f"padronizado {g}")
                if not DRY:
                    g.write_text(new)
    for f in sorted((IA / "agents").glob("*.md")):
        text = f.read_text()
        new = fix_paths(text)
        if new != text:
            info(f"padronizado {f}")
            if not DRY:
                f.write_text(new)


def sync_skills(t):
    d = t["skills"]
    if not d:
        return
    if d.is_symlink():  # alguém ligou a pasta inteira; prefiro por skill
        if not DRY:
            d.unlink()
    if not DRY:
        d.mkdir(parents=True, exist_ok=True)
    want = {s.name for s in (IA / "skills").iterdir() if (s / "SKILL.md").exists()}
    for name in sorted(want):
        symlink(IA / "skills" / name, d / name)
    if d.is_dir():
        for e in d.iterdir():
            if points_into_ia(e) and e.name not in want:
                info(f"removido link órfão {e}")
                if not DRY:
                    e.unlink()


def load_agents():
    out = {}
    ad = IA / "agents"
    for f in sorted(ad.glob("*.md")) if ad.is_dir() else []:
        try:
            meta, body = parse_front(f.read_text())
        except ValueError as e:
            warn(f"{f}: {e}")
            continue
        meta.setdefault("name", f.stem)
        out[f.stem] = (f, meta, body.strip())
    return out


def toml_str(s):
    if "'''" not in s and not s.startswith("\n"):
        return "'''\n" + s + "\n'''"
    return json.dumps(s, ensure_ascii=False)


def sync_agents(t, agents, state):
    fmt, d = t.get("agents_fmt"), t.get("agents")
    if not fmt or not d:
        return
    if d.is_symlink() and not DRY:
        d.unlink()
    want = set()
    for stem, (f, meta, body) in agents.items():
        desc = str(meta.get("description", ""))
        extra = meta.get(fmt) if isinstance(meta.get(fmt), dict) else {}
        if fmt == "claude":
            symlink(f, d / f.name)
            want.add(str(d / f.name))
            continue
        if fmt == "codex":
            p = d / f"{stem}.toml"
            c = (f"# gerado por ia-sync a partir de {f} — edite lá\nname = {json.dumps(meta['name'])}\n"
                 f"description = {json.dumps(desc, ensure_ascii=False)}\n"
                 + "".join(f"{json.dumps(k) if not re.fullmatch(r'[A-Za-z0-9_-]+', k) else k} = {toml_val(v)}\n" for k, v in extra.items())
                 + f"developer_instructions = {toml_str(body)}\n")
            try:
                tomllib.loads(c)
            except Exception as e:
                warn(f"agente {stem}: toml do codex ficaria inválido ({e}); pulado")
                continue
        elif fmt == "copilot":
            p = d / f"{stem}.agent.md"
            c = dump_front({"name": meta["name"], "description": desc, **extra},
                           f"<!-- gerado por ia-sync a partir de {f} — edite lá -->\n{body}")
        elif fmt == "kiro":
            p = d / f"{stem}.json"
            c = json.dumps({"name": meta["name"], "description": desc, **extra, "prompt": body}, indent=2, ensure_ascii=False) + "\n"
        else:
            continue
        write_generated(p, c, state)
        want.add(str(p))
    # limpa gerados/links que não existem mais
    if d.is_dir():
        for e in d.iterdir():
            if str(e) in want:
                continue
            if points_into_ia(e) or (str(e) in state["generated"] and e.is_file()):
                info(f"removido agente órfão {e}")
                if not DRY:
                    e.unlink()
                state["generated"].pop(str(e), None)


def sync_instructions(t):
    if t.get("instructions") and AGENTS_MD.exists():
        symlink(AGENTS_MD, t["instructions"])


def sync_settings(t):
    for rel, target in t["settings"]:
        canon = IA / rel
        if canon.exists():
            symlink(canon, target)


def desired_mcp(secrets):
    canon = json.loads(MCP_FILE.read_text()) if MCP_FILE.exists() else {"mcpServers": {}}
    out = {}
    for n, s in canon.get("mcpServers", {}).items():
        if s.get("disabled") is True:
            continue
        out[n] = (s.get("only"), s.get("skip") or [], expand({k: v for k, v in s.items() if k not in ("only", "skip", "disabled")}, secrets))
    return out


def for_tool(desired, tid):
    """Servidores dessa ferramenta, já com os campos extras dela (chave com o nome da ferramenta)."""
    out = {}
    for n, (only, skip, s) in desired.items():
        if (only and tid not in only) or tid in skip:
            continue
        extra = s.get(tid) if isinstance(s.get(tid), dict) else {}
        out[n] = {**{k: v for k, v in s.items() if k not in TOOL_IDS}, **extra}
    return out


MCP_CORE = {"type", "url", "headers", "command", "args", "env"}


def sync_mcp_claude(servers, prev):
    cj = HOME / ".claude.json"
    cur = json.loads(cj.read_text()).get("mcpServers", {}) if cj.exists() else {}
    claude = shutil.which("claude")
    if not claude:
        warn("CLI 'claude' não encontrado; MCPs do Claude não sincronizados")
        return
    for n in sorted(prev - set(servers)):
        if n in cur:
            info(f"claude: removendo MCP '{n}'")
            if not DRY:
                subprocess.run([claude, "mcp", "remove", "-s", "user", n], capture_output=True)
    for n, s in servers.items():
        if cur.get(n) == s:
            continue
        info(f"claude: {'atualizando' if n in cur else 'adicionando'} MCP '{n}'")
        if DRY:
            continue
        if n in cur:
            subprocess.run([claude, "mcp", "remove", "-s", "user", n], capture_output=True)
        r = subprocess.run([claude, "mcp", "add-json", "-s", "user", n, json.dumps(s)], capture_output=True, text=True)
        if r.returncode:
            warn(f"claude mcp add-json {n}: {r.stderr.strip() or r.stdout.strip()}")


def toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_val(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{json.dumps(k)} = {toml_val(x)}" for k, x in v.items()) + " }"
    return json.dumps(str(v), ensure_ascii=False)


def sync_mcp_codex(servers, prev):
    cfg = IA / "settings/codex/config.toml"
    if not cfg.exists():
        cfg = HOME / ".codex/config.toml"
    text = cfg.read_text() if cfg.exists() else ""
    names = set(servers) | prev
    out, skipping = [], False
    for line in text.splitlines():
        m = re.match(r"^\s*\[\s*mcp_servers\.(\"[^\"]+\"|[A-Za-z0-9_-]+)(\.|\s*\])", line)
        if m:
            skipping = m.group(1).strip('"') in names
        elif re.match(r"^\s*\[", line):
            skipping = False
        if line.strip() in ("# >>> ia-sync mcp (gerado; edite ~/.ia/mcp/servers.json) >>>", "# <<< ia-sync mcp <<<"):
            continue
        if not skipping:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    block = ["", "# >>> ia-sync mcp (gerado; edite ~/.ia/mcp/servers.json) >>>"]
    for n, s in sorted(servers.items()):
        key = n if re.fullmatch(r"[A-Za-z0-9_-]+", n) else json.dumps(n)
        block.append(f"[mcp_servers.{key}]")
        if s.get("url"):
            block.append(f"url = {toml_val(s['url'])}")
            if s.get("headers"):
                block.append(f"http_headers = {toml_val(s['headers'])}")
        else:
            block.append(f"command = {toml_val(s['command'])}")
            if s.get("args"):
                block.append(f"args = {toml_val(s['args'])}")
            if s.get("env"):
                block.append(f"env = {toml_val(s['env'])}")
        for k, v in s.items():
            if k not in MCP_CORE:
                block.append(f"{k if re.fullmatch(r'[A-Za-z0-9_-]+', k) else json.dumps(k)} = {toml_val(v)}")
        block.append("")
    block.append("# <<< ia-sync mcp <<<")
    new = "\n".join(out + block) + "\n"
    try:
        tomllib.loads(new)
    except Exception as e:
        warn(f"config.toml do codex ficaria inválido ({e}); não alterado")
        return
    if new != text:
        info(f"codex: MCPs atualizados em {cfg}")
        if not DRY:
            cfg.write_text(new)


def sync_mcp_json(t, servers, prev, state):
    f = real_path(t, t["mcp_file"])
    data = {}
    if f.exists():
        try:
            data = json.loads(f.read_text())
        except Exception:
            warn(f"{f} inválido; recriando")
    ms = data.setdefault("mcpServers", {})
    for n in prev - set(servers):
        ms.pop(n, None)
    for n, s in servers.items():
        if t["id"] == "copilot":
            e = {"type": "http", "url": s["url"]} if s.get("url") else {"type": "local", "command": s["command"], "args": s.get("args", [])}
            if s.get("headers"):
                e["headers"] = s["headers"]
            if s.get("env"):
                e["env"] = s["env"]
            e["tools"] = ["*"]
            e.update({k: v for k, v in s.items() if k not in MCP_CORE})
        elif t["id"] == "gemini":
            if s.get("url"):
                e = {("url" if s.get("type") == "sse" else "httpUrl"): s["url"]}
                if s.get("headers"):
                    e["headers"] = s["headers"]
            else:
                e = {"command": s["command"], "args": s.get("args", [])}
                if s.get("env"):
                    e["env"] = s["env"]
            e.update({k: v for k, v in s.items() if k not in MCP_CORE})
        else:  # kiro
            e = {k: v for k, v in s.items() if k != "type"}
        ms[n] = e
    c = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    if not f.exists() or f.read_text() != c:
        info(f"{t['id']}: MCPs atualizados em {f}")
        if not DRY:
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(c)
            f.chmod(0o600)
    for rel, target in t["settings"]:  # config criado agora no ~/.ia: já liga
        if f == IA / rel and (f.exists() or DRY):
            symlink(f, target)


def sync_mcp(tl, state):
    secrets = load_secrets()
    desired = desired_mcp(secrets)
    prev_all = state.setdefault("mcp", {})
    for t in tl:
        kind = t.get("mcp")
        if not kind:
            continue
        servers = for_tool(desired, t["id"])
        prev = set(prev_all.get(t["id"], [])) - set(servers)
        if kind == "claude-cli":
            sync_mcp_claude(servers, prev)
        elif kind == "codex-toml":
            sync_mcp_codex(servers, prev)
        else:
            sync_mcp_json(t, servers, prev, state)
        prev_all[t["id"]] = sorted(servers)
    prev_all["managed"] = sorted(desired)


# ---------------------------------------------------------------- main
def ensure_layout():
    for sub in ("skills", "agents", "mcp", "settings"):
        (IA / sub).mkdir(parents=True, exist_ok=True)
    if not (IA / MARKER).exists() and not DRY:
        (IA / MARKER).write_text("pasta de configs de IA do ia-sync (não apague)\n")
    # fora do git: segredos, estado, backups e configs onde os MCPs são gravados já com os segredos expandidos
    gi = IA / ".gitignore"
    want = ["secrets.env", ".state.json", "_backup/", "_conflicts/",
            "settings/codex/config.toml", "settings/gemini/settings.json", "settings/copilot/config.json"]
    cur = gi.read_text().splitlines() if gi.exists() else []
    missing = [w for w in want if w not in cur]
    if missing and not DRY:
        gi.write_text("\n".join(cur + missing) + "\n")
    # deixa o comando `ia-sync` no PATH
    me, link = IA / "bin" / "ia-sync", HOME / ".local" / "bin" / "ia-sync"
    if me.exists() and not link.exists() and not link.is_symlink():
        info(f"instalado comando {link} -> {me}")
        if not DRY:
            link.parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(me)
    if str(link.parent) not in os.environ.get("PATH", "").split(":"):
        warn(f"{link.parent} não está no PATH; adicione no ~/.bashrc: export PATH=\"$HOME/.local/bin:$PATH\"")


def first_run_backup(tl):
    """Na 1ª execução guarda tudo que pode ser mexido, pra dar pra voltar atrás."""
    if STATE_FILE.exists() or DRY:
        return
    paths = {HOME / ".claude.json"}
    for t in tl:
        paths |= {t.get(k) for k in ("skills", "agents", "instructions", "mcp_file", "steering")}
        paths |= {target for _, target in t["settings"]}
    paths = sorted(p for p in paths if p and (p.exists() or p.is_symlink()))
    if not paths:
        return
    dest = IA / "_backup" / f"pre-ia-sync-{TS}.tgz"
    dest.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(dest, "w:gz") as tar:
        for p in paths:
            tar.add(p, arcname=rel_home(p))
    info(f"backup do estado atual em {dest}")


def status(tl):
    print(f"fonte: {IA}")
    print(f"  skills: {', '.join(sorted(p.name for p in (IA/'skills').iterdir() if (p/'SKILL.md').exists()))}")
    print(f"  agentes: {', '.join(sorted(load_agents())) or '-'}")
    print(f"  MCPs: {', '.join(json.loads(MCP_FILE.read_text())['mcpServers']) if MCP_FILE.exists() else '-'}")
    for t in tl:
        print(f"[{t['id']}] {t['home']}")
        for label, p in (("skills", t["skills"]), ("instruções", t.get("instructions"))):
            if not p:
                continue
            if label == "skills":
                n = sum(1 for e in p.iterdir() if points_into_ia(e)) if p.is_dir() else 0
                loose = [e.name for e in p.iterdir() if p.is_dir() and e.is_dir() and not e.is_symlink() and e.name not in IGNORED_SKILL_DIRS and (e / "SKILL.md").exists()] if p.is_dir() else []
                print(f"  skills: {n} ligadas" + (f", SOLTAS: {loose}" if loose else ""))
            else:
                print(f"  instruções: {'ok' if points_into_ia(p) else 'NÃO ligado'} ({p})")
        for rel, target in t["settings"]:
            print(f"  config: {'ok' if points_into_ia(target) else 'NÃO ligado'} ({target})")


def main():
    global DRY, QUIET
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", default="sync", choices=["sync", "status"])
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()
    DRY, QUIET = a.dry_run, a.quiet
    tl = tools()
    ensure_layout()
    if a.cmd == "status":
        status(tl)
        return
    first_run_backup(tl)
    if not QUIET:
        print(f"importando o que estiver fora do {SHOW}...")
    for t in tl:
        import_skills(t)
        import_agents(t)
        import_instructions(t)
        import_settings(t)
        import_steering(t)
    import_mcp(tl)
    if not QUIET:
        print("sincronizando ferramentas: " + ", ".join(t["id"] for t in tl))
    normalize()
    state = load_state()
    agents = load_agents()
    for t in tl:
        sync_skills(t)
        sync_agents(t, agents, state)
        sync_instructions(t)
        sync_settings(t)
        sync_steering(t)
    sync_mcp(tl, state)
    save_state(state)
    if not QUIET:
        print(f"pronto: {len(changes)} mudança(s), {len(warnings)} aviso(s){' (dry-run)' if DRY else ''}")


if __name__ == "__main__":
    main()
